---
// AudioPlayer Component — supports pre-rendered MP3 audio files (Sanity asset CDN) with Web Speech API fallback
interface Props {
  audioUrl?: string;
}

const { audioUrl } = Astro.props;
---
<div class="premium-audio-player" id="audioPlayerContainer" data-audio-url={audioUrl || ''}>
  <div class="player-cover">
    <div class="disc-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    </div>
  </div>

  <div class="player-controls">
    <button id="playBtn" class="play-pause-btn" aria-label="Listen to article" title="Listen to article">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
    </button>
    <button id="pauseBtn" class="play-pause-btn hidden" aria-label="Pause reading" title="Pause">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
    </button>
  </div>

  <div class="player-info">
    <div class="player-title-row">
      <span class="player-title">Listen to article</span>
      <span class="time-display" id="timeDisplay">0:00</span>
    </div>
    
    {/* Seek bar for MP3 mode / Waveform for Speech mode */}
    <div class="progress-bar-container" id="progressBarContainer">
      <input type="range" id="audioSeeker" class="audio-seeker" value="0" min="0" max="100" step="0.1" aria-label="Audio progress seeker" />
      <div class="progress-bar-fill" id="progressBarFill"></div>
    </div>
  </div>

  <div class="player-actions">
    {/* Speed toggle for MP3 mode */}
    <button id="speedBtn" class="speed-btn" title="Playback speed">1x</button>

    <button id="stopBtn" class="stop-btn hidden" aria-label="Stop reading" title="Stop">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect></svg>
    </button>
  </div>
</div>

<script>
  const playerContainer = document.getElementById('audioPlayerContainer');
  const staticAudioUrl = playerContainer?.getAttribute('data-audio-url');

  const playBtn = document.getElementById('playBtn');
  const pauseBtn = document.getElementById('pauseBtn');
  const stopBtn = document.getElementById('stopBtn');
  const speedBtn = document.getElementById('speedBtn');
  const timeDisplay = document.getElementById('timeDisplay');
  const audioSeeker = document.getElementById('audioSeeker');
  const progressBarFill = document.getElementById('progressBarFill');

  let isPlaying = false;

  // ── MODE A: Pre-rendered MP3 File ─────────────────────────────────────────
  if (staticAudioUrl && staticAudioUrl.trim() !== '') {
    const audio = new Audio(staticAudioUrl);
    const speeds = [1, 1.25, 1.5, 2];
    let speedIndex = 0;

    const formatTime = (secs) => {
      if (isNaN(secs)) return '0:00';
      const m = Math.floor(secs / 60);
      const s = Math.floor(secs % 60);
      return `${m}:${s < 10 ? '0' : ''}${s}`;
    };

    audio.addEventListener('loadedmetadata', () => {
      timeDisplay.textContent = `0:00 / ${formatTime(audio.duration)}`;
    });

    audio.addEventListener('timeupdate', () => {
      if (!isNaN(audio.duration) && audio.duration > 0) {
        const percent = (audio.currentTime / audio.duration) * 100;
        audioSeeker.value = percent.toString();
        progressBarFill.style.width = `${percent}%`;
        timeDisplay.textContent = `${formatTime(audio.currentTime)} / ${formatTime(audio.duration)}`;
      }
    });

    audioSeeker?.addEventListener('input', (e) => {
      const val = parseFloat(e.target.value);
      if (!isNaN(audio.duration)) {
        audio.currentTime = (val / 100) * audio.duration;
      }
    });

    playBtn?.addEventListener('click', () => {
      audio.play();
      isPlaying = true;
      playBtn.classList.add('hidden');
      pauseBtn.classList.remove('hidden');
      stopBtn.classList.remove('hidden');
      playerContainer.classList.add('is-playing');
    });

    pauseBtn?.addEventListener('click', () => {
      audio.pause();
      isPlaying = false;
      playBtn.classList.remove('hidden');
      pauseBtn.classList.add('hidden');
    });

    stopBtn?.addEventListener('click', () => {
      audio.pause();
      audio.currentTime = 0;
      isPlaying = false;
      playBtn.classList.remove('hidden');
      pauseBtn.classList.add('hidden');
      stopBtn.classList.add('hidden');
      playerContainer.classList.remove('is-playing');
      progressBarFill.style.width = '0%';
    });

    audio.addEventListener('ended', () => {
      isPlaying = false;
      playBtn.classList.remove('hidden');
      pauseBtn.classList.add('hidden');
      stopBtn.classList.add('hidden');
      playerContainer.classList.remove('is-playing');
      progressBarFill.style.width = '0%';
    });

    speedBtn?.addEventListener('click', () => {
      speedIndex = (speedIndex + 1) % speeds.length;
      audio.playbackRate = speeds[speedIndex];
      speedBtn.textContent = `${speeds[speedIndex]}x`;
    });

  } else {
    // ── MODE B: Fallback Web Speech Synthesis ──────────────────────────────
    const synth = typeof window !== 'undefined' ? window.speechSynthesis : null;
    let readableElements = [];
    let currentIndex = 0;
    let currentUtterance = null;
    let isPaused = false;
    const speeds = [1, 1.25, 1.5];
    let speedIndex = 0;

    const getReadableElements = () => {
      if (readableElements.length === 0) {
        readableElements = Array.from(
          document.querySelectorAll('.prose p, .prose h2, .prose h3, .prose li')
        ).filter(el => (el.textContent || '').trim().length > 0);
      }
      return readableElements;
    };

    const resetHighlight = () => {
      getReadableElements().forEach(el => el.classList.remove('reading-highlight'));
    };

    const highlightElement = (index) => {
      resetHighlight();
      const els = getReadableElements();
      if (index >= 0 && index < els.length) {
        els[index].classList.add('reading-highlight');
        els[index].scrollIntoView({ behavior: 'smooth', block: 'center' });
        
        const percent = ((index + 1) / els.length) * 100;
        audioSeeker.value = percent.toString();
        progressBarFill.style.width = `${percent}%`;
        timeDisplay.textContent = `${index + 1} / ${els.length} sections`;
      }
    };

    const speakChunk = (index) => {
      const els = getReadableElements();
      if (index >= els.length) {
        stopSpeech();
        return;
      }

      currentIndex = index;
      const text = (els[index].textContent || '').trim();
      if (!text) {
        speakChunk(index + 1);
        return;
      }

      highlightElement(index);

      currentUtterance = new SpeechSynthesisUtterance(text);
      currentUtterance.rate = speeds[speedIndex];

      currentUtterance.onend = () => {
        if (isPlaying && !isPaused) {
          speakChunk(index + 1);
        }
      };

      currentUtterance.onerror = () => stopSpeech();

      synth?.speak(currentUtterance);
    };

    const startSpeech = () => {
      if (!synth) return;
      if (isPaused) {
        synth.resume();
        isPaused = false;
        isPlaying = true;
        playBtn.classList.add('hidden');
        pauseBtn.classList.remove('hidden');
        playerContainer.classList.add('is-playing');
        return;
      }

      synth.cancel();
      isPlaying = true;
      isPaused = false;
      playBtn.classList.add('hidden');
      pauseBtn.classList.remove('hidden');
      stopBtn.classList.remove('hidden');
      playerContainer.classList.add('is-playing');
      speakChunk(currentIndex);
    };

    const pauseSpeech = () => {
      if (!synth) return;
      synth.pause();
      isPaused = true;
      isPlaying = false;
      playBtn.classList.remove('hidden');
      pauseBtn.classList.add('hidden');
    };

    const stopSpeech = () => {
      if (synth) synth.cancel();
      isPlaying = false;
      isPaused = false;
      currentIndex = 0;
      resetHighlight();
      playBtn.classList.remove('hidden');
      pauseBtn.classList.add('hidden');
      stopBtn.classList.add('hidden');
      playerContainer.classList.remove('is-playing');
      progressBarFill.style.width = '0%';
      timeDisplay.textContent = 'Listen';
    };

    playBtn?.addEventListener('click', startSpeech);
    pauseBtn?.addEventListener('click', pauseSpeech);
    stopBtn?.addEventListener('click', stopSpeech);

    speedBtn?.addEventListener('click', () => {
      speedIndex = (speedIndex + 1) % speeds.length;
      speedBtn.textContent = `${speeds[speedIndex]}x`;
      if (isPlaying) {
        synth?.cancel();
        speakChunk(currentIndex);
      }
    });

    window.addEventListener('beforeunload', () => synth?.cancel());
  }
</script>

<style>
  .premium-audio-player {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: #0a0a0c;
    border-radius: 1.25rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
    margin: 2rem 0;
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.3s ease;
  }

  .premium-audio-player.is-playing {
    border-color: var(--orange);
    box-shadow: 0 15px 35px rgba(255, 107, 0, 0.18);
  }

  .player-cover {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--orange);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .disc-icon {
    color: var(--white);
    display: flex;
  }

  .premium-audio-player.is-playing .disc-icon {
    animation: spin 6s linear infinite;
  }

  @keyframes spin {
    100% { transform: rotate(360deg); }
  }

  .player-controls {
    display: flex;
    align-items: center;
  }

  .play-pause-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--white);
    color: #0a0a0c;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .play-pause-btn:hover {
    transform: scale(1.05);
    background-color: var(--orange);
    color: var(--white);
  }

  .play-pause-btn.hidden {
    display: none;
  }

  .player-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .player-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .player-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .time-display {
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.6);
    white-space: nowrap;
  }

  .progress-bar-container {
    position: relative;
    width: 100%;
    height: 6px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
    overflow: hidden;
    display: flex;
    align-items: center;
  }

  .progress-bar-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background-color: var(--orange);
    border-radius: 3px;
    transition: width 0.1s linear;
  }

  .audio-seeker {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
    margin: 0;
  }

  .player-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .speed-btn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--white);
    padding: 0.3rem 0.6rem;
    border-radius: 1rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .speed-btn:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: var(--orange);
  }

  .stop-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .stop-btn:hover {
    color: var(--orange);
  }

  .stop-btn.hidden {
    display: none;
  }

  :global(.reading-highlight) {
    background-color: rgba(255, 107, 0, 0.15) !important;
    border-radius: 0.25rem;
    box-shadow: 0 0 0 4px rgba(255, 107, 0, 0.15);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }
</style>
