---
// AudioPlayer Component — powered by native Web Speech Synthesis API
---
<div class="premium-audio-player" id="audioPlayerContainer">
  <div class="player-cover">
    <div class="disc-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    </div>
  </div>

  <div class="player-controls">
    <button id="playBtn" class="play-pause-btn" aria-label="Listen to article" title="Listen to article">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
    </button>
    <button id="pauseBtn" class="play-pause-btn hidden" aria-label="Pause reading" title="Pause">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>
    </button>
  </div>

  <div class="player-info">
    <span class="player-title">Listen to this article</span>
    <div class="waveform" id="waveform">
      <span class="bar"></span><span class="bar"></span><span class="bar"></span><span class="bar"></span>
      <span class="bar"></span><span class="bar"></span><span class="bar"></span><span class="bar"></span>
      <span class="bar"></span><span class="bar"></span><span class="bar"></span><span class="bar"></span>
    </div>
  </div>

  <div class="player-actions">
    <div class="voice-dropdown-container" id="voiceDropdownContainer">
      <button id="voiceDropdownBtn" class="voice-dropdown-btn">
        <svg class="voice-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg>
        <span id="selectedVoiceLabel">Default Voice</span>
        <svg class="chevron-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
      </button>
      <div id="voiceDropdownMenu" class="voice-dropdown-menu hidden"></div>
    </div>

    <span class="status-text" id="statusText">Listen</span>

    <button id="stopBtn" class="stop-btn hidden" aria-label="Stop reading" title="Stop">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect></svg>
    </button>
  </div>
</div>

<script>
  // Native Browser SpeechSynthesis Engine
  const synth = typeof window !== 'undefined' ? window.speechSynthesis : null;

  const playBtn = document.getElementById('playBtn');
  const pauseBtn = document.getElementById('pauseBtn');
  const stopBtn = document.getElementById('stopBtn');
  const statusText = document.getElementById('statusText');
  const waveformEl = document.getElementById('waveform');
  const playerContainer = document.getElementById('audioPlayerContainer');
  const voiceDropdownBtn = document.getElementById('voiceDropdownBtn');
  const voiceDropdownMenu = document.getElementById('voiceDropdownMenu');
  const selectedVoiceLabel = document.getElementById('selectedVoiceLabel');

  let voices = [];
  let selectedVoice = null;
  let readableElements = [];
  let currentIndex = 0;
  let currentUtterance = null;
  let isSpeaking = false;
  let isPaused = false;

  const getReadableElements = () => {
    if (readableElements.length === 0) {
      readableElements = Array.from(
        document.querySelectorAll('.prose p, .prose h2, .prose h3, .prose li')
      ).filter(el => (el.textContent || '').trim().length > 0);
    }
    return readableElements;
  };

  const resetHighlight = () => {
    getReadableElements().forEach(el => el.classList.remove('reading-highlight'));
  };

  const highlightElement = (index) => {
    resetHighlight();
    const els = getReadableElements();
    if (index >= 0 && index < els.length) {
      els[index].classList.add('reading-highlight');
      els[index].scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  };

  const setState = (state) => {
    const active = state === 'playing';
    playBtn.classList.toggle('hidden', active);
    pauseBtn.classList.toggle('hidden', !active);
    stopBtn.classList.toggle('hidden', state === 'ready');
    waveformEl.classList.toggle('active', active);
    playerContainer.classList.toggle('is-playing', active);

    const labels = {
      playing: 'Reading',
      paused: 'Paused',
      ready: 'Listen',
    };
    statusText.textContent = labels[state] ?? 'Listen';
  };

  const populateVoices = () => {
    if (!synth) return;
    voices = synth.getVoices().filter(v => v.lang.startsWith('en'));
    if (voices.length === 0) voices = synth.getVoices();

    if (voiceDropdownMenu) {
      voiceDropdownMenu.innerHTML = '';
      voices.slice(0, 8).forEach((voice, index) => {
        const btn = document.createElement('button');
        btn.className = `voice-option ${index === 0 ? 'active' : ''}`;
        btn.textContent = voice.name.replace(/(Google|Microsoft|Apple|Desktop)/g, '').trim();
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          selectedVoice = voice;
          selectedVoiceLabel.textContent = btn.textContent;
          document.querySelectorAll('.voice-option').forEach(o => o.classList.remove('active'));
          btn.classList.add('active');
          voiceDropdownMenu.classList.add('hidden');
          if (isSpeaking) stopReading();
        });
        voiceDropdownMenu.appendChild(btn);
      });
      if (voices.length > 0 && !selectedVoice) {
        selectedVoice = voices[0];
        selectedVoiceLabel.textContent = voices[0].name.replace(/(Google|Microsoft|Apple|Desktop)/g, '').trim();
      }
    }
  };

  if (synth) {
    populateVoices();
    if (synth.onvoiceschanged !== undefined) {
      synth.onvoiceschanged = populateVoices;
    }
  }

  voiceDropdownBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    voiceDropdownMenu?.classList.toggle('hidden');
  });

  document.addEventListener('click', () => {
    voiceDropdownMenu?.classList.add('hidden');
  });

  const speakChunk = (index) => {
    const els = getReadableElements();
    if (index >= els.length) {
      stopReading();
      return;
    }

    currentIndex = index;
    const text = (els[index].textContent || '').trim();
    if (!text) {
      speakChunk(index + 1);
      return;
    }

    highlightElement(index);

    currentUtterance = new SpeechSynthesisUtterance(text);
    if (selectedVoice) currentUtterance.voice = selectedVoice;
    currentUtterance.rate = 1.0;

    currentUtterance.onend = () => {
      if (isSpeaking && !isPaused) {
        speakChunk(index + 1);
      }
    };

    currentUtterance.onerror = () => {
      stopReading();
    };

    synth?.speak(currentUtterance);
  };

  const startReading = () => {
    if (!synth) return;
    if (isPaused) {
      synth.resume();
      isPaused = false;
      isSpeaking = true;
      setState('playing');
      return;
    }

    synth.cancel();
    isSpeaking = true;
    isPaused = false;
    setState('playing');
    speakChunk(currentIndex);
  };

  const pauseReading = () => {
    if (!synth) return;
    synth.pause();
    isPaused = true;
    isSpeaking = false;
    setState('paused');
  };

  const stopReading = () => {
    if (synth) synth.cancel();
    isSpeaking = false;
    isPaused = false;
    currentIndex = 0;
    resetHighlight();
    setState('ready');
  };

  playBtn?.addEventListener('click', startReading);
  pauseBtn?.addEventListener('click', pauseReading);
  stopBtn?.addEventListener('click', stopReading);
  window.addEventListener('beforeunload', () => synth?.cancel());
</script>

<style>
  .premium-audio-player {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: #0a0a0c;
    border-radius: 1rem;
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
    margin: 2rem 0;
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.3s ease;
  }

  .premium-audio-player.is-playing {
    border-color: var(--orange);
    box-shadow: 0 15px 35px rgba(255, 107, 0, 0.15);
  }

  .player-cover {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--orange);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .disc-icon {
    color: var(--white);
    display: flex;
  }

  .premium-audio-player.is-playing .disc-icon {
    animation: spin 6s linear infinite;
  }

  @keyframes spin {
    100% { transform: rotate(360deg); }
  }

  .player-controls {
    display: flex;
    align-items: center;
  }

  .play-pause-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--white);
    color: #0a0a0c;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease;
  }

  .play-pause-btn:hover {
    transform: scale(1.05);
    background-color: var(--orange);
    color: var(--white);
  }

  .play-pause-btn.hidden {
    display: none;
  }

  .player-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.375rem;
    overflow: hidden;
    min-width: 0;
  }

  .player-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--white);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .waveform {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 14px;
  }

  .waveform .bar {
    display: block;
    width: 3px;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    height: 25%;
  }

  .waveform.active .bar {
    background-color: var(--orange);
    animation: bounce 0.8s infinite ease-in-out alternate;
  }

  .waveform.active .bar:nth-child(1)  { animation-delay: 0.0s; }
  .waveform.active .bar:nth-child(2)  { animation-delay: 0.2s; }
  .waveform.active .bar:nth-child(3)  { animation-delay: 0.4s; }
  .waveform.active .bar:nth-child(4)  { animation-delay: 0.1s; }
  .waveform.active .bar:nth-child(5)  { animation-delay: 0.5s; }
  .waveform.active .bar:nth-child(6)  { animation-delay: 0.3s; }
  .waveform.active .bar:nth-child(7)  { animation-delay: 0.6s; }

  @keyframes bounce {
    0%   { height: 20%; }
    100% { height: 100%; }
  }

  .player-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .voice-dropdown-container {
    position: relative;
  }

  .voice-dropdown-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--white);
    padding: 0.375rem 0.75rem;
    border-radius: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .voice-dropdown-btn:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .voice-dropdown-menu {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    right: 0;
    background: #141417;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.75rem;
    padding: 0.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 150px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    z-index: 20;
  }

  .voice-dropdown-menu.hidden {
    display: none;
  }

  .voice-option {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.8);
    padding: 0.4rem 0.75rem;
    text-align: left;
    border-radius: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    cursor: pointer;
  }

  .voice-option:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--white);
  }

  .voice-option.active {
    background: rgba(255, 107, 0, 0.2);
    color: var(--orange);
    font-weight: 600;
  }

  .status-text {
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stop-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 0.25rem;
  }

  .stop-btn:hover {
    color: var(--orange);
  }

  .stop-btn.hidden {
    display: none;
  }

  :global(.reading-highlight) {
    background-color: rgba(255, 107, 0, 0.15) !important;
    border-radius: 0.25rem;
    box-shadow: 0 0 0 4px rgba(255, 107, 0, 0.15);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }
</style>
